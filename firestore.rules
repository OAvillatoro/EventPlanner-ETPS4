rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // MARK: - Usuarios privados

    match /users/{userId} {

      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      allow create: if isOwner()
        && request.resource.data.keys().hasAll([
          'name', 'email', 'organization'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'organization'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.organization is string;

      allow read: if isOwner();

      allow update: if isOwner()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'name', 'organization'
          ]);

      allow delete: if false;
    }

    // MARK: - Nombres visibles de asistentes

    match /attendeeProfiles/{userId} {

      allow get: if request.auth != null;

      allow list: if false;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name ==
          get(/databases/$(database)/documents/users/$(userId)).data.name;

      allow delete: if false;
    }

    // MARK: - Eventos

    match /events/{eventId} {

      function isOrganizer() {
        return request.auth != null
          && resource.data.organizerId == request.auth.uid;
      }

      function validEvent() {
        return request.resource.data.keys().hasAll([
          'title', 'description', 'category',
          'location', 'date', 'capacity',
          'organizerId', 'attendees'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category',
          'location', 'date', 'capacity',
          'organizerId', 'attendees'
        ])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.category in [
          'Académico', 'Social', 'Deportivo', 'Cultural'
        ]
        && request.resource.data.location is string
        && request.resource.data.date is timestamp
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.organizerId is string
        && request.resource.data.attendees is list
        && request.resource.data.attendees.size()
          <= request.resource.data.capacity
        && request.resource.data.attendees.toSet().size()
          == request.resource.data.attendees.size();
      }

      function validAttendanceChange() {
        let before = resource.data.attendees;
        let after = request.resource.data.attendees;

        return request.auth != null
          && request.auth.uid != resource.data.organizerId
          && validEvent()
          && resource.data.date > request.time
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['attendees'])
          && (
            (
              !(request.auth.uid in before)
              && request.auth.uid in after
              && after.size() == before.size() + 1
              && after.hasAll(before)
            )
            ||
            (
              request.auth.uid in before
              && !(request.auth.uid in after)
              && after.size() == before.size() - 1
              && before.hasAll(after)
            )
          );
      }

      // Consultar eventos
      allow read: if request.auth != null;

      // Crear eventos
      allow create: if request.auth != null
        && validEvent()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.attendees == [];

      // Editar evento o actualizar asistencia
      allow update: if (
        (
          isOrganizer()
          && validEvent()
          && request.resource.data.organizerId
            == resource.data.organizerId
          && request.resource.data.attendees
            == resource.data.attendees
        )
        ||
        validAttendanceChange()
      );

      // Eliminar eventos
      allow delete: if isOrganizer();
    }
  }
}
